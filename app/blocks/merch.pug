//- Блок Мерч
mixin merch
    section.merch.container(id="merch")
        .merch__container
            h2.merch__title.title Мерч
            p.merch__subtitle.subtitle Одежда и аксессуары с принтами из коллекции
            
            .merch__grid
                //- Карточка товара 1
                .merch-card
                    .merch-card__image
                        img(src="images-min/merch/merch-6.webp" alt="Футболка Инвестиция №4")
                    h3.merch-card__title Футболка «Деньги не спят»
                    .merch-card__price 5 500 ₽
                    button.merch-card__button.button.button--gray(type="button" data-product="Футболка «Инвестиция №4»") Заказать
                
                //- Карточка товара 2 
                .merch-card
                    .merch-card__image
                        img(src="images-min/merch/merch-2.webp" alt="Худи Инвестиция №7")
