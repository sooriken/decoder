mixin dipsie
    // Боковая навигация Dipsie (только десктоп)
    //- Dipsie navigation
    .dipsie(id="dipsie")
        .dipsie__item.dipsie__item--active(data-section="hero")
            .dipsie__label Приветствие
            .dipsie__line
        
        .dipsie__item(data-section="exhibition")
            .dipsie__label Выставка
            .dipsie__line
        
        .dipsie__item(data-section="reproductions")
            .dipsie__label Репродукции
            .dipsie__line
        
        .dipsie__item(data-section="merch")
            .dipsie__label Мерч
            .dipsie__line
        
        .dipsie__item(data-section="media")
            .dipsie__label Медиа
            .dipsie__line
        
        .dipsie__item(data-section="originals")
            .dipsie__label Оригиналы
            .dipsie__line

        .dipsie__item(data-section="mission")
            .dipsie__label Миссия
            .dipsie__line
        
        .dipsie__item(data-section="feedback")
            .dipsie__label Связь
            .dipsie__line