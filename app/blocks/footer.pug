mixin footer
    footer.footer.container(id="footer")
        .footer__container
            .footer__grid
                // Левый блок: бренд и контакты
                .footer__brand
                    .footer__logo investme
                    .footer__contacts
                        a.footer__link(href="mailto:hello@investme.ru") hello@investme.ru
                        a.footer__link(href="https://t.me/investme_bot") @investme_bot
                
                // Центральный блок: реквизиты и оферта
                .footer__info
                    .footer__requisites
                        p.footer__text ИП Иванова А.А.
                        p.footer__text ИНН 123456789012
                    a.footer__link.footer__link--oferta(href="#") Политика обработки данных
                    a.footer__link.footer__link--oferta(href="#") Договор оферты
                
                // Правый блок: соцсети
                .footer__socials
                    a.footer__social-inner(href="#" target="_blank")
                        .footer__social-icon(src="#", alt="#")
                            <svg width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                                <!-- Фон иконки (#1A3B2B) -->
                                <rect width="40" height="40" rx="4" fill="red"/>
                                
                                <!-- Самолёт Telegram цветом #EEE5D3 -->
