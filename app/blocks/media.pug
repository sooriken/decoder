mixin media
    //- Блок СМИ / Медиа
    section.media.container(id="media")
        .media__container
            h2.media__title.title СМИ о проекте
            .media__logos
                .media__logo-item
                    .media__logo-placeholder 
                .media__logo-item
                    .media__logo-placeholder 
                .media__logo-item
                    .media__logo-placeholder 
                .media__logo-item
                    .media__logo-placeholder 
            .media__brics
                .media__brics-icon
                    img(src="images-min/media/brics.webp" alt="Благодарность от организаторов юридического форума БРИКС за вклад в развитие культурного сотрудничества")
                p.media__brics-text.subtitle Благодарность от организаторов юридического форума БРИКС за вклад в развитие культурного сотрудничества